{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- /* Taxonomy and term pages are noindexed (see partials/head.html), so
         listing them here would only ask crawlers to fetch pages we tell them
         to drop. changefreq and priority are omitted — Google ignores both. */}}
  {{- range .Pages }}
    {{- if not (in (slice "taxonomy" "term") .Kind) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
  </url>
    {{- end }}
  {{- end }}
</urlset>
